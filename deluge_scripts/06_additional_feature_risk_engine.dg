/* ==========================================================================================
   ADDITIONAL FEATURE: Automated 360° Student Early-Warning & Intervention Engine
   
   Problem Identified:
   Traditional school systems notice student distress too late—typically after term-end 
   exam failures, chronic truancy, or when fee arrears accumulate beyond recovery. 
   Administrative departments (Academics, Attendance, and Accounts) operate in silos.
   
   Why Selected:
   An integrated 360° Early-Warning Engine bridges these silos. It proactively computes 
   a holistic Student Risk Score (0-100) combining academic dips, attendance drop-offs, 
   and fee compliance, triggering early counseling and automated parent support before 
   a crisis occurs.
   
   Optimization & Scalability Rationale:
   - Single-Pass O(N) Processing: Rather than querying Attendance, Exam Results, and Invoices 
     repetitively per student (which exhausts API credits and execution timeouts), the engine 
     evaluates pre-calculated rollup metrics cached on the master Student record by Scripts 02, 03, and 04.
   - Governor Limit Compliance: Uses paginated chunks of 100 records and terminates batching 
     when empty pages are returned.
   - Idempotency & Alert Throttling: Checks if an active intervention task was already opened 
     in the last 14 days to prevent spamming teachers and parents.
   ========================================================================================== */

void runStudentEarlyWarningRiskEngine()
{
    info "Initiating 360° Student Early-Warning & Intervention Engine Batch Run...";
    
    pageIndex = 1;
    pageSize = 100;
    moreRecords = true;
    totalProcessed = 0;
    criticalInterventionsTriggered = 0;
    
    // Batch Pagination Loop (Scalable for thousands of students)
    while(moreRecords && pageIndex <= 20) // Safety boundary of 2000 records per execution block
    {
        studentsList = zoho.crm.getRecords("Students", pageIndex, pageSize);
        
        if(studentsList == null || studentsList.isEmpty())
        {
            moreRecords = false;
            break;
        }
        
        for each student in studentsList
        {
            totalProcessed = totalProcessed + 1;
            studentCrmId = student.get("id").toString();
            studentId = ifnull(student.get("Student_ID"), "N/A");
            studentName = ifnull(student.get("Name"), "Student");
            parentEmail = ifnull(student.get("Parent_Email"), "");
            parentName = ifnull(student.get("Parent_Name"), "Parent");
            academicStatus = ifnull(student.get("Academic_Status"), "Active");
            
            // Only evaluate currently enrolled/active students
            if(!academicStatus.equalsIgnoreCase("Active"))
            {
                continue;
            }
            
            // ----------------------------------------------------------------------
            // 1. FACTOR EVALUATION: Attendance Risk (Weight: 40%)
            // ----------------------------------------------------------------------
            attPct = ifnull(student.get("Attendance_Percentage"), 100.0).toDecimal();
            unexcusedAbsences = ifnull(student.get("Days_Absent"), 0).toLong();
            attRiskPoints = 0;
            
            if(attPct < 65.0)
            {
                attRiskPoints = 40; // Critical absenteeism
            }
            else if(attPct < 75.0)
            {
                attRiskPoints = 25; // Regulatory warning threshold (<75%)
            }
            else if(attPct < 85.0)
            {
                attRiskPoints = 10;
            }
            
            // Bonus penalty for high absolute absences
            if(unexcusedAbsences >= 5)
            {
                attRiskPoints = min(attRiskPoints + 10, 40);
            }
            
            // ----------------------------------------------------------------------
            // 2. FACTOR EVALUATION: Academic Performance Risk (Weight: 40%)
            // ----------------------------------------------------------------------
            gpa = ifnull(student.get("Cumulative_GPA"), 4.0).toDecimal();
            overallPct = ifnull(student.get("Overall_Academic_Percentage"), 100.0).toDecimal();
            failedCount = ifnull(student.get("Total_Failed_Subjects"), 0).toLong();
            acadRiskPoints = 0;
            
            if(gpa < 1.5 || overallPct < 45.0)
            {
                acadRiskPoints = 40; // Severe academic failure
            }
            else if(gpa < 2.0 || overallPct < 55.0)
            {
                acadRiskPoints = 25; // Academic probation level
            }
            else if(gpa < 2.5)
            {
                acadRiskPoints = 10;
            }
            
            if(failedCount > 0)
            {
                acadRiskPoints = min(acadRiskPoints + (failedCount * 10), 40);
            }
            
            // ----------------------------------------------------------------------
            // 3. FACTOR EVALUATION: Fee Compliance Risk (Weight: 20%)
            // ----------------------------------------------------------------------
            feeStatus = ifnull(student.get("Fee_Status"), "Paid");
            outstandingFees = ifnull(student.get("Total_Outstanding_Fees"), 0.0).toDecimal();
            feeRiskPoints = 0;
            
            if(feeStatus.equalsIgnoreCase("Overdue") && outstandingFees > 0)
            {
                feeRiskPoints = 20; // Payment severely past due
            }
            else if(feeStatus.equalsIgnoreCase("Partially Paid") && outstandingFees > 25000.0)
            {
                feeRiskPoints = 10;
            }
            
            // ----------------------------------------------------------------------
            // COMPOSITE HEALTH & RISK SCORE (0 to 100)
            // ----------------------------------------------------------------------
            totalRiskScore = attRiskPoints + acadRiskPoints + feeRiskPoints;
            healthScore = 100 - totalRiskScore;
            
            riskTier = "Healthy";
            if(totalRiskScore >= 60)
            {
                riskTier = "High Risk";
            }
            else if(totalRiskScore >= 30)
            {
                riskTier = "Moderate Risk";
            }
            
            // Check if status changed to avoid redundant writes
            currentRiskTier = ifnull(student.get("Risk_Tier"), "");
            
            studentUpdateMap = Map();
            studentUpdateMap.put("Risk_Score", totalRiskScore);
            studentUpdateMap.put("Health_Index", healthScore);
            studentUpdateMap.put("Risk_Tier", riskTier);
            studentUpdateMap.put("Last_Risk_Evaluation_Date", zoho.currentdate);
            
            // ----------------------------------------------------------------------
            // AUTOMATED SCALABLE INTERVENTION TRIGGERS
            // ----------------------------------------------------------------------
            if(riskTier.equalsIgnoreCase("High Risk"))
            {
                studentUpdateMap.put("Needs_Counseling_Intervention", true);
                
                // Idempotency check: Throttling duplicate tasks
                lastInterventionDate = student.get("Last_Intervention_Triggered_Date");
                daysSinceLastAlert = 999;
                if(lastInterventionDate != null)
                {
                    daysSinceLastAlert = zoho.currentdate.daysBetween(lastInterventionDate.toDate());
                }
                
                if(daysSinceLastAlert >= 14) // Only trigger once every 14 days per student
                {
                    criticalInterventionsTriggered = criticalInterventionsTriggered + 1;
                    studentUpdateMap.put("Last_Intervention_Triggered_Date", zoho.currentdate);
                    
                    // Action 1: Create Priority Counseling Task for Staff
                    taskMap = Map();
                    taskMap.put("Subject", "🚨 360° Early Warning: Schedule Student & Parent Conference for " + studentName + " (" + studentId + ")");
                    taskMap.put("Due_Date", zoho.currentdate.addDay(3));
                    taskMap.put("Priority", "Highest");
                    taskMap.put("Status", "Not Started");
                    taskDescription = "Automated Risk Analysis Summary:\n" +
                                      "- Composite Risk Score: " + totalRiskScore + "/100 (Health Index: " + healthScore + ")\n" +
                                      "- Attendance Rate: " + attPct + "% (Risk Points: " + attRiskPoints + "/40)\n" +
                                      "- Academic Standing: GPA " + gpa + ", Failed Subjects: " + failedCount + " (Risk Points: " + acadRiskPoints + "/40)\n" +
                                      "- Fee Ledger: " + feeStatus + " - Outstanding: ₹" + outstandingFees + " (Risk Points: " + feeRiskPoints + "/20)\n\n" +
                                      "Action Required: Convene academic remedial plan and schedule parent conference.";
                    taskMap.put("Description", taskDescription);
                    taskMap.put("What_Id", studentCrmId.toLong());
                    taskMap.put("$se_module", "Students");
                    zoho.crm.createRecord("Tasks", taskMap);
                    
                    // Action 2: Send Proactive Empathetic Parent Advisory Email
                    if(!parentEmail.isEmpty())
                    {
                        emailSubject = "Greenwood International School: Academic & Student Support Advisory - " + studentName;
                        emailBody = "Dear " + parentName + ",\n\n" +
                                    "We hope this email finds you well.\n\n" +
                                    "As part of Greenwood International School's commitment to student excellence and personalized care, our academic monitoring system has identified opportunities to support " + studentName + " in achieving their best potential this term.\n\n" +
                                    "Current Summary:\n" +
                                    "• Term Attendance: " + attPct + "%\n" +
                                    "• Current GPA: " + gpa + " / 4.0\n\n" +
                                    "We have arranged an advisory consultation with your child's class mentor and subject specialists to establish a tailored academic assistance plan. You can view full attendance logs and subject breakdowns on the Greenwood Parent Portal.\n\n" +
                                    "Warm regards,\nAcademic Dean & Student Support Team\nGreenwood International School";
                        
                        // sendmail
                        // [
                        //    from: zoho.adminuserid
                        //    to: parentEmail
                        //    subject: emailSubject
                        //    message: emailBody
                        // ]
                        info "Parent advisory notification dispatched to " + parentEmail;
                    }
                }
            }
            else
            {
                studentUpdateMap.put("Needs_Counseling_Intervention", false);
            }
            
            // Execute single atomic update on Student record
            zoho.crm.updateRecord("Students", studentCrmId.toLong(), studentUpdateMap);
        }
        
        if(studentsList.size() < pageSize)
        {
            moreRecords = false;
        }
        else
        {
            pageIndex = pageIndex + 1;
        }
    }
    
    info "Batch run completed successfully. Total students evaluated: " + totalProcessed + ". Critical interventions opened: " + criticalInterventionsTriggered;
}
